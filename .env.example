# Copy this file to .env and choose the initial admin password before `just up`.
# Existing accounts are not reset when this value changes.
ADMIN_PASSWORD=

# Optional overrides:
# PORT=3000
# SALON_TIME_ZONE=America/New_York
# SENTRY_ENVIRONMENT=local-docker
# SENTRY_RELEASE=chairflow@poc
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=1.0
# Uncomment to disable Sentry for this local installation:
# SENTRY_DSN=
