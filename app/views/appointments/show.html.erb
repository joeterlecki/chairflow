<% content_for :title, "Appointment details · Chairflow" %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag "booking_details" do %>
    <dialog class="booking-dialog" aria-labelledby="booking-details-title" data-controller="booking-dialog" data-action="cancel->booking-dialog#close close->booking-dialog#closed click->booking-dialog#backdrop keydown->booking-dialog#trapFocus turbo:before-cache@document->booking-dialog#close">
      <%= render "details", modal: true %>
    </dialog>
  <% end %>
<% else %>
  <div class="mx-auto max-w-2xl">
    <%= link_to "← Back to the calendar", back_to_calendar_path(@appointment), class: "mb-6 inline-block text-sm text-stone-500" %>
    <div class="calendar-panel"><%= render "details", modal: false %></div>
  </div>
<% end %>
