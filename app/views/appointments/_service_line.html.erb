<div class="mb-3 flex items-end gap-2" data-booking-form-target="row">
  <div class="flex-1">
    <%= line.label :service_id, "Service", class: "mb-1 block text-sm font-medium text-ink" %>
    <div class="relative">
      <%= line.select :service_id,
            options_for_select(
              Service.active.map { |s| [ s.name, s.id, { "data-duration": s.default_duration_minutes } ] },
              line.object.service_id
            ),
            { prompt: true },
            class: "w-full appearance-none rounded-xl border border-line bg-surface px-3 py-2 pr-8 text-ink",
            data: { action: "change->booking-form#fillDuration" } %>
      <%= select_chevron %>
    </div>
  </div>
  <div class="w-28">
    <%= line.label :duration_minutes, "Minutes", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= line.number_field :duration_minutes,
          min: 1,
          data: { "booking-form-target": "duration", action: "input->booking-form#updateTotal" },
          class: "w-full rounded-xl border border-line bg-surface px-3 py-2 text-ink" %>
  </div>
  <button type="button" data-action="booking-form#remove"
          class="rounded-xl border border-line bg-surface px-3 py-2 text-sm text-ink">Remove</button>
</div>
