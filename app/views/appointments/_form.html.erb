<%= form_with model: appointment, data: { turbo_frame: "_top" } do |form| %>
  <%= render "shared/errors", object: appointment %>

  <div class="mb-4 max-w-md">
    <%= form.label :client_id, "Client", class: "mb-1 block text-sm font-medium text-ink" %>
    <div class="relative">
      <%= form.collection_select :client_id, Client.alphabetical, :id, :name, { prompt: true },
            class: "w-full appearance-none rounded-xl border border-line bg-surface px-3 py-2 pr-8 text-ink" %>
      <%= select_chevron %>
    </div>
  </div>

  <div class="mb-4 max-w-md">
    <%= form.label :stylist_id, "Stylist", class: "mb-1 block text-sm font-medium text-ink" %>
    <div class="relative">
      <%= form.collection_select :stylist_id, Stylist.active, :id, :name, { prompt: true },
            class: "w-full appearance-none rounded-xl border border-line bg-surface px-3 py-2 pr-8 text-ink" %>
      <%= select_chevron %>
    </div>
  </div>

  <datalist id="services-datalist">
    <% Service.active.each do |service| %>
      <option value="<%= service.name %>"></option>
    <% end %>
  </datalist>

  <div class="mb-6 max-w-md" data-controller="service-lines">
    <div data-service-lines-target="rows">
      <%= form.fields_for :appointment_services do |line| %>
        <%= render "service_line", line: line %>
      <% end %>
    </div>

    <template data-service-lines-target="template">
      <%= form.fields_for :appointment_services, AppointmentService.new, child_index: "NEW_RECORD" do |line| %>
        <%= render "service_line", line: line %>
      <% end %>
    </template>

    <div class="flex items-center justify-between">
      <button type="button" data-action="service-lines#add" class="rounded-xl border border-line bg-surface px-3 py-2 text-sm text-ink">
        + Add a service
      </button>
      <p class="text-sm text-muted">Total: <span data-service-lines-target="total">0 min</span></p>
    </div>
  </div>

  <div class="mb-6 max-w-md">
    <%= form.label :starts_at, "Time", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= form.datetime_local_field :starts_at,
          class: "w-full rounded-xl border border-line bg-surface px-3 py-2 text-ink" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit "Book appointment", class: "rounded-xl bg-pine px-4 py-2 text-white hover:bg-pine-hover" %>
    <%= link_to "Never mind", root_path,
          data: { turbo_frame: "_top" },
          class: "rounded-xl border border-line bg-surface px-4 py-2 text-ink" %>
  </div>
<% end %>
