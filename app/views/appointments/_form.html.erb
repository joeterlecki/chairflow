<%= form_with model: appointment, data: { turbo_frame: "_top", controller: "booking-form" } do |form| %>
  <%= render "shared/errors", object: appointment %>

  <div class="relative mb-4 max-w-md">
    <%= label_tag "client_query", "Client", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= text_field_tag "client_query", appointment.client&.name || new_client_name,
          autocomplete: "off",
          placeholder: "Search or add a client",
          data: { "booking-form-target": "clientQuery", action: "input->booking-form#searchClients" },
          class: "w-full rounded-xl border border-line bg-surface px-3 py-2 text-ink" %>
    <%= form.hidden_field :client_id, data: { "booking-form-target": "clientId" } %>
    <%= hidden_field_tag "appointment[new_client_name]", new_client_name, data: { "booking-form-target": "newClientName" } %>
    <%= turbo_frame_tag "client_search",
          src: client_search_appointments_path,
          data: { "booking-form-target": "clientResults", "base-url": client_search_appointments_path } %>
  </div>

  <div class="mb-4 max-w-md">
    <%= form.label :stylist_id, "Stylist", class: "mb-1 block text-sm font-medium text-ink" %>
    <div class="relative">
      <%= form.collection_select :stylist_id, Stylist.active, :id, :name, { prompt: true },
            class: "w-full appearance-none rounded-xl border border-line bg-surface px-3 py-2 pr-8 text-ink",
            data: { "booking-form-target": "stylist", action: "change->booking-form#refreshPlanner" } %>
      <%= select_chevron %>
    </div>
  </div>

  <div class="mb-6 max-w-md">
    <div data-booking-form-target="rows">
      <%= form.fields_for :appointment_services do |line| %>
        <%= render "service_line", line: line %>
      <% end %>
    </div>

    <template data-booking-form-target="template">
      <%= form.fields_for :appointment_services, AppointmentService.new, child_index: "NEW_RECORD" do |line| %>
        <%= render "service_line", line: line %>
      <% end %>
    </template>

    <div class="flex items-center justify-between">
      <button type="button" data-action="booking-form#add" class="rounded-xl border border-line bg-surface px-3 py-2 text-sm text-ink">
        + Add a service
      </button>
      <p class="text-sm text-muted">Total: <span data-booking-form-target="total">0 min</span></p>
    </div>
  </div>

  <div class="mb-6 max-w-md">
    <p class="mb-1 text-sm font-medium text-ink">Find the right moment</p>
    <%= turbo_frame_tag "day_planner",
          src: day_planner_appointments_path(date: date),
          data: { "booking-form-target": "plannerFrame" },
          class: "block rounded-xl border border-line bg-surface px-3 py-3" %>
  </div>

  <div class="mb-6 max-w-md">
    <%= form.label :starts_at, "Time", class: "mb-1 block text-sm font-medium text-ink" %>
    <%= form.datetime_local_field :starts_at,
          data: { "booking-form-target": "startsAt" },
          class: "w-full rounded-xl border border-line bg-surface px-3 py-2 text-ink" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit "Book appointment", class: "rounded-xl bg-pine px-4 py-2 text-white hover:bg-pine-hover" %>
    <%= link_to "Never mind", root_path,
          data: { turbo_frame: "_top" },
          class: "rounded-xl border border-line bg-surface px-4 py-2 text-ink" %>
  </div>
<% end %>
