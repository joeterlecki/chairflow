<%= turbo_frame_tag "day_availability", data: { availability_target: "frame", action: "turbo:frame-missing->availability#failed" } do %>
  <div class="calendar-panel p-5 md:p-6">
    <p class="eyebrow">FIND THE RIGHT MOMENT</p>
    <div class="mt-3 flex items-center justify-between gap-3">
      <div><h2 class="text-xl font-semibold"><%= availability.starts_at.strftime("%A, %b %-d") %></h2><p class="mt-1 text-sm text-stone-500"><%= availability.stylist&.name || "Your stylist’s day" %> · <%= availability.duration %> min</p></div>
      <div class="flex gap-1"><button type="button" class="icon-button" data-action="availability#shiftDay" data-days="-1" aria-label="Previous day">←</button><button type="button" class="icon-button" data-action="availability#shiftDay" data-days="1" aria-label="Next day">→</button></div>
    </div>
    <% if availability.stylist %>
      <% conflicts = availability.conflicts_at(availability.starts_at) %>
      <% reason = availability.unavailable_reason %>
      <div role="status" class="my-5 rounded-xl border p-4 text-sm <%= reason ? 'border-red-200 bg-red-50 text-red-800' : 'border-green-200 bg-green-50 text-green-900' %>">
        <p class="font-semibold"><%= availability.starts_at.strftime("%-I:%M %p") %> – <%= (availability.starts_at + availability.duration.minutes).strftime("%-I:%M %p") %> · <%= reason || "No booking conflicts" %></p>
        <% if conflicts.any? %><p class="mt-1">Overlaps with <%= conflicts.map { |booking| booking.client.name }.to_sentence %>. Try an open time below.</p><% elsif reason %><p class="mt-1">Choose an open time, another stylist, or another day.</p><% else %><p class="mt-1">There’s room for this <%= availability.duration %>-minute appointment.</p><% end %>
      </div>
      <h3 class="text-sm font-semibold">Open start times</h3>
      <p class="mb-4 mt-1 text-xs leading-relaxed text-stone-500">
        <% if availability.working_day && !availability.working_day.closed? %>
          Working hours: <%= availability.working_day.opens_at %>–<%= availability.working_day.closes_at %>.
          <% if availability.working_day.break_starts_at.present? %>Break: <%= availability.working_day.break_starts_at %>–<%= availability.working_day.break_ends_at %>.<% end %>
          Click a time to select it. Starts offered every 15 minutes.
        <% else %>This stylist is <%= availability.working_day.is_a?(TimeOff) ? "on time off" : "off" %> today.<% end %>
      </p>
      <% open_slots = availability.open_slots %>
      <% if open_slots.empty? %><p class="rounded-xl bg-stone-50 p-4 text-sm text-stone-500">No room for <%= availability.duration %> minutes in this window. Try another day, stylist, or duration.</p><% end %>
      <div class="grid grid-cols-3 gap-2 sm:grid-cols-4">
        <% open_slots.each do |time| %>
          <button type="button" class="time-slot <%= 'chosen' if time == availability.starts_at %>" data-action="availability#select" data-time="<%= time.strftime('%Y-%m-%dT%H:%M') %>" aria-pressed="<%= time == availability.starts_at %>"><%= time.strftime("%-I:%M %p") %></button>
        <% end %>
      </div>
      <div class="mt-6 border-t border-stone-200 pt-5">
        <h3 class="mb-3 text-sm font-semibold">Already on the books <span class="ml-1 font-normal text-stone-400">(<%= availability.bookings.size %>)</span></h3>
        <% if availability.bookings.empty? %><p class="text-sm text-stone-500">A clear day. Make it a good one.</p><% end %>
        <div class="space-y-2">
          <% availability.bookings.each do |booking| %>
            <div class="rounded-xl border-l-[3px] p-3 <%= booking.stylist.color %>">
              <p class="text-xs font-semibold"><%= booking.starts_at.strftime("%-I:%M %p") %> – <%= booking.ends_at.strftime("%-I:%M %p") %></p>
              <p class="mt-1 text-sm font-medium"><%= booking.client.name %></p><p class="text-xs opacity-80"><%= booking.service %></p>
            </div>
          <% end %>
        </div>
      </div>
      <p class="mt-5 text-xs text-stone-400">Times in <%= Time.zone.tzinfo.identifier %>. Availability is checked again when you save.</p>
    <% else %>
      <div class="mt-6 rounded-xl bg-stone-50 p-6 text-sm leading-relaxed text-stone-500">Choose a stylist to see their bookings and open times for this day.</div>
    <% end %>
  </div>
<% end %>
