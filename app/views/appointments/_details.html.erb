<div class="booking-details-content">
  <header class="flex items-start justify-between gap-4 border-b border-stone-200 bg-[#fafbf8] p-6 sm:p-8">
    <div class="min-w-0">
      <p class="eyebrow">A MOMENT IN THE CHAIR</p>
      <h2 id="booking-details-title" class="mt-3 break-words text-3xl font-medium tracking-tight"><%= @appointment.client.name %></h2>
      <p class="mt-2 text-sm text-stone-500"><%= @appointment.service %></p>
    </div>
    <% if modal %><button type="button" class="icon-button shrink-0" aria-label="Close booking details" data-action="booking-dialog#close"><span aria-hidden="true">×</span></button><% end %>
  </header>

  <div class="booking-details-body space-y-6 p-6 sm:p-8">
    <section aria-label="Appointment schedule">
      <p class="text-lg font-medium"><%= @appointment.starts_at.strftime("%A, %B %-d, %Y") %></p>
      <p class="mt-2 text-2xl font-medium tracking-tight"><%= @appointment.starts_at.strftime("%-I:%M %p") %> <span class="text-stone-400">–</span> <%= @appointment.ends_at.strftime("%-I:%M %p") %></p>
      <p class="mt-2 text-xs text-stone-500"><%= @appointment.duration_minutes %> minutes · <%= Time.zone.tzinfo.identifier %></p>
    </section>

    <dl class="grid grid-cols-2 gap-5 rounded-xl border border-stone-200 p-4">
      <div><dt class="eyebrow">STYLIST</dt><dd class="mt-2 flex items-center gap-2 text-sm font-medium"><span class="color-dot shrink-0 <%= @appointment.stylist.color %>"></span><%= @appointment.stylist.name %></dd></div>
      <div><dt class="eyebrow">CLIENT PREFERENCE</dt><dd class="mt-2 text-sm"><%= @appointment.client.preferred_stylist&.name || "No preference" %></dd></div>
    </dl>

    <section aria-labelledby="booking-contact-heading">
      <h3 id="booking-contact-heading" class="eyebrow">CLIENT CONTACT</h3>
      <dl class="mt-3 space-y-3 text-sm">
        <div class="flex flex-wrap justify-between gap-x-4 gap-y-1"><dt class="text-stone-500">Email</dt><dd class="min-w-0 break-all"><% if @appointment.client.email.present? %><%= mail_to @appointment.client.email, class: "underline decoration-stone-300 underline-offset-4" %><% else %><span class="text-stone-400">Not provided</span><% end %></dd></div>
        <div class="flex flex-wrap justify-between gap-x-4 gap-y-1"><dt class="text-stone-500">Phone</dt><dd><% if @appointment.client.phone.present? %><%= link_to @appointment.client.phone, "tel:#{@appointment.client.phone.gsub(/[^+\d]/, '')}", class: "underline decoration-stone-300 underline-offset-4" %><% else %><span class="text-stone-400">Not provided</span><% end %></dd></div>
      </dl>
    </section>

    <section aria-labelledby="booking-notes-heading" class="border-t border-stone-200 pt-5">
      <h3 id="booking-notes-heading" class="eyebrow">VISIT NOTES</h3>
      <% if @appointment.notes.present? %><p class="mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed text-stone-600"><%= @appointment.notes %></p><% else %><p class="mt-3 text-sm text-stone-400">Nothing noted for this visit.</p><% end %>
    </section>
  </div>

  <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-stone-200 bg-white px-6 py-5 sm:px-8">
    <% if modal %><button type="button" class="button" data-action="booking-dialog#close">Done</button><% else %><%= link_to "Back to calendar", back_to_calendar_path(@appointment), class: "button" %><% end %>
    <%= link_to "Edit appointment", edit_appointment_path(@appointment, stylist_id: params[:stylist_id], calendar_view: params[:calendar_view]), class: "button button-primary", data: { turbo_frame: "_top" } %>
  </footer>
</div>
