<%= turbo_frame_tag "team_schedule", data: { turbo_action: "advance" } do %>
  <section class="mb-7 flex flex-wrap items-end justify-between gap-4">
    <div><p class="eyebrow">A RHYTHM THAT WORKS</p><h1 class="mt-2 text-4xl font-medium tracking-tight md:text-5xl">The team schedule.</h1><p class="mt-3 text-stone-500">See who’s in. Make room for time away.</p></div>
    <%= link_to "+ Add time off", new_time_off_path(date: @days.include?(Date.current) ? Date.current : @week), class: "button button-primary", data: { turbo_frame: "_top" } %>
  </section>
  <section class="calendar-panel">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-200 p-5">
      <div class="flex flex-wrap items-center gap-3"><div class="flex gap-1"><%= link_to "←", team_schedule_path(week: @week - 7), class: "icon-button", aria: { label: "Previous week" } %><%= link_to "→", team_schedule_path(week: @week + 7), class: "icon-button", aria: { label: "Next week" } %></div><h2 class="text-lg font-semibold"><%= @week.strftime("%b %-d") %> – <%= (@week + 6).strftime("%b %-d, %Y") %></h2><%= link_to "This week", team_schedule_path, class: "button button-small" %></div>
      <span class="text-xs text-stone-500"><%= pluralize(@stylists.size, "team member") %> · <%= Time.zone.tzinfo.identifier %></span>
    </div>
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Weekly team coverage">
      <table class="team-table">
        <thead><tr><th class="team-name-cell">Team member</th><% @days.each do |date| %><th class="<%= 'today-column' if date == Date.current %>"><%= link_to root_path(view: "day", date: date), class: "flex items-center justify-center gap-2", data: { turbo_frame: "_top" } do %><span class="eyebrow"><%= date.strftime('%a') %></span><span class="grid-date-number <%= 'is-today' if date == Date.current %>"><%= date.day %></span><% end %><span class="mt-1 block text-[10px] font-normal text-stone-500"><%= @stylists.count { |stylist| (schedule = @schedules[stylist.id][date]) && !schedule.closed? } %> on · <%= number_with_precision(@stylists.sum { |stylist| coverage_hours(@schedules[stylist.id][date], date) }, precision: 1, strip_insignificant_zeros: true) %>h coverage</span></th><% end %></tr></thead>
        <tbody><% @stylists.each do |stylist| %><tr>
          <th scope="row" class="team-name-cell"><div class="flex items-center gap-2"><span class="color-dot <%= stylist.color %>"></span><%= stylist.name %></div><p class="mt-2 text-xs font-normal text-stone-500"><%= number_with_precision(@days.sum { |date| coverage_hours(@schedules[stylist.id][date], date) }, precision: 1, strip_insignificant_zeros: true) %>h this week</p><%= link_to "Recurring hours", edit_stylist_path(stylist), class: "mt-3 inline-block text-xs font-normal text-stone-500 underline underline-offset-4", aria: { label: "Edit hours for #{stylist.name}" }, data: { turbo_frame: "_top" } %></th>
          <% @days.each do |date| %>
            <% schedule = @schedules[stylist.id][date] %>
            <% bookings = @bookings.fetch([stylist.id, date], []) %>
            <% conflicts = bookings.count { |booking| !schedule&.permits?(booking.starts_at, booking.ends_at) } %>
            <td data-stylist-id="<%= stylist.id %>" data-date="<%= date %>">
              <%= link_to edit_stylist_shift_path(stylist, date: date), class: "team-shift #{schedule && !schedule.closed? ? stylist.color : 'off-shift'}", aria: { label: "Edit #{stylist.name} shift on #{date.strftime('%B %-d')}" }, data: { turbo_frame: "_top" } do %>
                <span class="text-[10px] opacity-70"><%= schedule_source(schedule) %></span>
                <span class="mt-2 block text-sm font-semibold"><%= schedule && !schedule.closed? ? "#{schedule.opens_at}–#{schedule.closes_at}" : schedule.is_a?(TimeOff) ? "Time off" : "Off" %></span>
                <% if schedule && !schedule.closed? && schedule.break_starts_at.present? %><span class="mt-2 block text-[10px] opacity-80">Break <%= schedule.break_starts_at %>–<%= schedule.break_ends_at %></span><% end %>
                <% if bookings.any? %><span class="mt-3 block text-[10px] opacity-80"><%= pluralize(bookings.size, "booking") %></span><% end %>
                <% if conflicts.positive? %><span class="mt-2 block text-xs font-semibold text-red-800"><%= pluralize(conflicts, "booking") %> outside shift</span><% end %>
              <% end %>
            </td>
          <% end %>
        </tr><% end %></tbody>
      </table>
      <% if @stylists.empty? %><p class="p-8 text-center text-stone-500">No team members yet. Run the demo seeds to get started.</p><% end %>
    </div>
    <footer class="border-t border-stone-200 px-5 py-4 text-xs text-stone-500">Click a shift to change just that date. Recurring hours set the usual week. Coverage totals exclude breaks.</footer>
  </section>
  <% if @time_offs.any? %>
    <section class="mt-7"><h2 class="mb-3 text-lg font-semibold">Time away this week</h2><div class="calendar-panel divide-y divide-stone-200"><% @time_offs.each do |absence| %><div class="flex flex-wrap items-center justify-between gap-3 p-5"><div><p class="font-medium"><%= absence.stylist.name %> <span class="ml-2 text-sm font-normal text-stone-500"><%= absence.starts_on.strftime('%b %-d') %> – <%= absence.ends_on.strftime('%b %-d, %Y') %></span></p><% if absence.note.present? %><p class="mt-1 text-sm text-stone-500"><%= absence.note %></p><% end %></div><%= button_to "Remove time off", time_off_path(absence), method: :delete, class: "text-xs text-stone-500 underline underline-offset-4", form: { data: { turbo_frame: "_top", turbo_confirm: "Remove this time off and restore the underlying schedule?" } } %></div><% end %></div></section>
  <% end %>
<% end %>
