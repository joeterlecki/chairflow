<div class="mx-auto max-w-xl"><%= link_to "← Team schedule", team_schedule_path(week: @time_off.starts_on&.beginning_of_week), class: "text-sm text-stone-500" %><p class="eyebrow mt-7">ROOM TO RECHARGE</p><h1 class="mb-3 mt-2 text-3xl font-medium">Plan some time away.</h1><p class="mb-7 text-sm text-stone-500">Block one day or a date range. Existing bookings must be rescheduled before time off can be saved.</p>
  <div class="calendar-panel p-6"><%= render "shared/errors", record: @time_off %><%= render "shared/schedule_conflicts", bookings: @time_off.conflicting_appointments %>
    <%= form_with model: @time_off, class: "space-y-5" do |form| %>
      <div><%= form.label :stylist_id, "Team member" %><%= form.collection_select :stylist_id, @stylists, :id, :name, { prompt: "Choose a team member" }, required: true %></div>
      <div class="grid grid-cols-2 gap-4"><div><%= form.label :starts_on, "First day off" %><%= form.date_field :starts_on, required: true %></div><div><%= form.label :ends_on, "Last day off" %><%= form.date_field :ends_on, required: true %></div></div>
      <div><%= form.label :note, "Note (optional)" %><%= form.text_field :note, maxlength: 200, placeholder: "Vacation, personal day…" %><p class="field-hint">Both dates are included. Uses the salon’s time zone.</p></div>
      <%= form.submit "Save time off", class: "button button-primary cursor-pointer" %>
    <% end %>
  </div>
</div>
