<div class="mx-auto max-w-4xl"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="eyebrow">THE PEOPLE IN YOUR CHAIR</p><h1 class="mt-2 text-4xl font-medium">Clients.</h1></div><%= link_to "+ New client", new_client_path, class: "button button-primary" %></div>
<%= form_with url: clients_path, method: :get, class: "mb-6 flex items-end gap-3" do |form| %><div class="flex-1"><%= form.label :q, "Search clients" %><%= form.search_field :q, value: params[:q], placeholder: "Name, email, or phone" %></div><%= form.submit "Search", class: "button cursor-pointer" %><% end %>
<div class="calendar-panel divide-y divide-stone-200"><% @clients.each do |client| %><div class="flex items-center justify-between gap-3 p-5"><div class="min-w-0"><h2 class="font-semibold"><%= client.name %></h2><p class="mt-1 break-words text-sm text-stone-500"><%= [client.email.presence, client.phone.presence].compact.join(" · ").presence || "No contact details yet" %></p><p class="mt-1 text-xs text-stone-500">Preferred stylist: <%= client.preferred_stylist&.name || "No preference" %></p></div><%= link_to "Edit", edit_client_path(client), class: "button button-small", aria: { label: "Edit #{client.name}" } %></div><% end %><% if @clients.empty? %><p class="p-6 text-stone-500">No clients found.</p><% end %></div>
<p class="mt-5 text-xs text-stone-500">Contact details are for your records. Reminders are not enabled and no messages are sent.</p></div>
