<div class="mx-auto max-w-xl"><%= link_to "← Services", services_path, class: "text-sm text-stone-500" %><h1 class="mb-6 mt-6 text-3xl font-medium"><%= @service.name %></h1>
<div class="calendar-panel p-6"><%= render "shared/errors", record: @service %><%= form_with model: @service do |form| %><%= form.label :default_duration, "Default duration" %><%= form.select :default_duration, Appointment::DURATIONS.map { |minutes| [ "#{minutes} minutes", minutes ] } %><p class="field-hint">Existing bookings keep their saved duration.</p><%= form.submit "Save service", class: "button button-primary mt-6 cursor-pointer" %><% end %></div></div>
