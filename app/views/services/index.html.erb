<div class="mx-auto max-w-3xl"><p class="eyebrow">TIME WELL SPENT</p><h1 class="mb-3 mt-2 text-4xl font-medium">Services.</h1><p class="mb-8 text-stone-500">Default durations for new bookings. You can still adjust individual appointments.</p>
<div class="calendar-panel divide-y divide-stone-200"><% @services.each do |service| %><div class="flex items-center justify-between gap-4 p-6"><div><h2 class="font-semibold"><%= service.name %></h2><p class="mt-1 text-sm text-stone-500"><%= service.default_duration %> minutes</p></div><%= link_to "Edit", edit_service_path(service), class: "button button-small", aria: { label: "Edit #{service.name}" } %></div><% end %></div></div>
