<% content_for :title, "Sign in · Chairflow" %>
<% content_for :head do %><meta name="turbo-visit-control" content="reload"><% end %>

<div class="mx-auto grid min-h-[65vh] max-w-5xl items-center gap-12 py-6 lg:grid-cols-2 lg:gap-20">
  <section class="hidden lg:block" aria-label="Welcome to Chairflow">
    <p class="eyebrow">A GOOD DAY STARTS HERE</p>
    <h1 class="mt-4 text-5xl font-medium leading-tight tracking-tight">Your salon.<br><span class="font-serif italic text-[#567160]">In rhythm.</span></h1>
    <p class="mt-6 max-w-sm text-base leading-relaxed text-stone-500">A calmer space to plan your day, care for your clients, and keep every chair in rhythm.</p>
    <div class="mt-10 max-w-sm rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" aria-hidden="true">
      <div class="mb-4 flex items-center justify-between"><span class="text-sm font-medium">A well-arranged day</span><span class="color-dot sage"></span></div>
      <div class="grid grid-cols-3 gap-3"><div class="h-20 rounded-lg border-l-[3px] sage p-3 text-xs">A fresh start.</div><div class="mt-5 h-24 rounded-lg border-l-[3px] clay p-3 text-xs">A familiar face.</div><div class="h-16 rounded-lg border-l-[3px] lavender p-3 text-xs">Room to breathe.</div></div>
    </div>
  </section>
  <section class="calendar-panel mx-auto w-full max-w-md p-7 sm:p-10" aria-labelledby="login-heading">
    <p class="eyebrow">WELCOME TO CHAIRFLOW</p>
    <h2 id="login-heading" class="mt-3 text-3xl font-medium tracking-tight">Welcome back.</h2>
    <p class="mb-8 mt-3 text-sm text-stone-500">Sign in and make room for a good day.</p>
    <% if flash[:alert] %><div role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"><%= flash[:alert] %></div><% end %>
    <%= form_with url: login_path, class: "space-y-5", data: { turbo: false } do |form| %>
      <div><%= form.label :username, "Username" %><%= form.text_field :username, value: params[:username], required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, placeholder: "Your username" %></div>
      <div><%= form.label :password, "Password" %><%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Your password", maxlength: 72 %></div>
      <%= form.submit "Sign in", class: "button button-primary w-full cursor-pointer !py-3.5" %>
    <% end %>
    <p class="mt-7 border-t border-stone-200 pt-5 text-center text-xs text-stone-400">Made for your chair. And everyone in it.</p>
  </section>
</div>
