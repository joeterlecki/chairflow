<% if bookings.any? %>
  <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4"><h2 class="mb-2 text-sm font-semibold text-amber-900">Bookings that need attention</h2><ul class="space-y-2 text-sm text-amber-900"><% bookings.each do |booking| %><li><%= link_to "#{booking.starts_at.strftime('%b %-d, %Y · %-I:%M %p')} · #{booking.client.name} (#{booking.duration_minutes} min)", edit_appointment_path(booking), class: "underline underline-offset-4" %></li><% end %></ul><p class="mt-3 text-xs text-amber-800">No schedule changes have been saved. Move or cancel these appointments first, then retry.</p></div>
<% end %>
